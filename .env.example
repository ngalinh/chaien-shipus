# Server port (default: 5000)
PORT=5000

# ---------- ZALO — BACKEND (đặt trong .env của chaien-shipus, VPS BASSO) ----------
# Khoá bí mật dùng CHUNG với CHAIEN_ZALO_API_KEY bên local-runner (2 chiều: backend gọi
# runner để gửi tin, VÀ runner tự đăng ký URL của nó lên đây qua /api/register-local).
ZALO_RUNNER_API_KEY=doi-thanh-chuoi-ngau-nhien-dai
# URL local-runner TĨNH — dùng khi máy runner có IP/host cố định gọi thẳng được (kể cả
# chạy cùng máy với backend). Nếu runner sau NAT/IP hay đổi, để trống và dùng cơ chế tự
# đăng ký (CHAIEN_REMOTE_BACKEND_URL bên local-runner) — backend sẽ ưu tiên URL vừa
# đăng ký, chỉ rơi về giá trị tĩnh này khi chưa/hết hạn đăng ký.
ZALO_RUNNER_URL=http://localhost:8091
# URL công khai của TRANG WEB chaien-shipus (khác domain gốc ai.basso.vn — đó là dashboard
# chọn bot của cả nền tảng BASSO; app chaien nằm dưới prefix /b/<bot-id> riêng). Dùng để bot
# tự động báo hàng về build link /print/arrival cho runner tự mở chụp ảnh phiếu.
PUBLIC_APP_URL=https://ai.basso.vn/b/e5f5323bdc7532ac

# ---------- LOCAL-RUNNER (báo hàng qua Zalo — đặt trong .env ở máy có Chrome) ----------
# Cổng HTTP nội bộ của local-runner.
CHAIEN_ZALO_PORT=8091
# Khoá bí mật — PHẢI khớp ZALO_RUNNER_API_KEY bên backend.
CHAIEN_ZALO_API_KEY=doi-thanh-chuoi-ngau-nhien-dai
# Bắt buộc phải có API key mới cho chạy (fail-closed). Tự bật khi NODE_ENV=production.
CHAIEN_ZALO_REQUIRE_API_KEY=
# Trang quản lý Zalo (self-hosted, giao diện Vuetify) dùng để gửi tin.
CHAIEN_ZALO_URL=https://zalo.basso.vn
# Khi 1 login quản nhiều tài khoản Zalo: tên account cần chọn trước khi gửi. Trống = account đang active.
CHAIEN_DEFAULT_ZALO_ACCOUNT=
# Đăng nhập tự động khi session Zalo Basso hết hạn (~1 tuần), dùng chung cho profile chưa gán credential riêng.
CHAIEN_ZALO_LOGIN_USER=
CHAIEN_ZALO_LOGIN_PASS=
# Giữ ấm session (tự đăng nhập lại trước khi hết hạn). Mặc định bật.
CHAIEN_SESSION_KEEPALIVE=true
# Mở cửa sổ browser để theo dõi/đăng nhập (false = hiện cửa sổ — nên để false trên Windows).
CHAIEN_ZALO_HEADLESS=false
# CHẾ ĐỘ TEST AN TOÀN: true = chỉ gửi thật tới SĐT trong CHAIEN_ZALO_TEST_PHONES.
CHAIEN_ZALO_TEST_MODE=true
CHAIEN_ZALO_TEST_PHONES=0900000000

# --- Tự đăng ký URL lên backend (dùng khi máy runner sau NAT/không có IP cố định) ---
# URL công khai của backend chaien-shipus (vd https://ai.basso.vn — nginx route /api/*
# về backend). runner sẽ POST /api/register-local tới đây. Để trống = không tự đăng ký
# (backend phải tự đặt ZALO_RUNNER_URL tĩnh).
CHAIEN_REMOTE_BACKEND_URL=
# URL công khai của CHÍNH máy runner để khai báo (tunnel ngrok/cloudflared, hoặc IP LAN cố
# định + port forward). Để trống = start.js tự dò IP public + CHAIEN_ZALO_PORT.
CHAIEN_ZALO_PUBLIC_URL=
# Chu kỳ heartbeat đăng ký lại (ms). Mặc định 30000 = 30s (backend lưu URL trong RAM).
CHAIEN_REGISTER_INTERVAL_MS=30000
